# 复制成 .env 再填：cp .env.example .env
# TMDB API key 申请地址：https://www.themoviedb.org/settings/api
# （免费，注册后在 API 设置里拿 v3 auth 的 API Key）
TMDB_API_KEY=

# NAS 本地目录（群晖上的实际路径，冒号左边是 NAS 路径，右边是容器内路径）
NAS_TV_DIR=/volume1/TV show
NAS_ANIME_DIR=/volume1/Anime

# 可选：集名语言（默认 zh-CN）
# TMDB_LANGUAGE=zh-CN

# 可选：监控目录，逗号分隔（默认 "/media/TV show,/media/Anime"）
# ORZ_WATCH_DIRS="/media/TV show,/media/Anime"

# 可选：安全网全量复扫间隔（秒），默认 0 关
# ORZ_RESCAN_INTERVAL=0

# 可选：手动模式（1 开 / 默认 0 自动）。开的时候 watcher 只记日志、
# 告诉你哪个文件夹有文件在等改名，绝不自己改名、建 nfo、调 TMDB；
# 改名要你自己跑命令：create（新剧）/ refresh（取缓存）/ folder（改一季）
# ORZ_MANUAL_MODE=1

# 可选：文件大小不变几秒后才改名，默认 5
# ORZ_STABLE_SECONDS=5
